{
  "schema": 1,
  "id": "prisma-2020",
  "name": "PRISMA 2020 (main checklist)",
  "version": "2020",
  "url": "https://www.prisma-statement.org",
  "citation": "Page MJ et al. The PRISMA 2020 statement. BMJ 2021;372:n71",
  "lines": ["review"],
  "item_count": 27,
  "items": [
    {"number": 1, "section": "Title", "topic": "Title",
     "targets": {"review": ["title-and-keywords.title"]},
     "evidence": [{"kind": "term", "any": ["systematic review", "systematic literature review", "meta-analysis", "meta analysis"]}]},
    {"number": 2, "section": "Abstract", "topic": "Abstract",
     "targets": {"review": ["abstract"]},
     "question": "Does the abstract cover each item of the PRISMA 2020 for Abstracts checklist?"},
    {"number": 3, "section": "Introduction", "topic": "Rationale",
     "targets": {"review": ["introduction.intro-rationale"]},
     "question": "Is the rationale set against what is already known?"},
    {"number": 4, "section": "Introduction", "topic": "Objectives",
     "targets": {"review": ["introduction.intro-objectives"]},
     "evidence": [{"kind": "command", "script": "skills/systematic-review/scripts/review_cli.py", "argv": ["--root", "{root}", "protocol", "check"], "expect": {"ok": true}}],
     "question": "Does the text state each objective or question the review addresses?"},
    {"number": 5, "section": "Methods", "topic": "Eligibility criteria",
     "targets": {"review": ["methods.m-eligibility"]},
     "evidence": [{"kind": "command", "script": "skills/systematic-review/scripts/review_cli.py", "argv": ["--root", "{root}", "protocol", "check"], "expect": {"ok": true}}],
     "question": "Are the inclusion and exclusion criteria and the grouping for synthesis stated?"},
    {"number": 6, "section": "Methods", "topic": "Information sources",
     "targets": {"review": ["methods.m-information-sources"]},
     "evidence": [{"kind": "record", "path": "review/searches.jsonl"}],
     "question": "Is every source named with the date it was last searched?"},
    {"number": 7, "section": "Methods", "topic": "Search strategy",
     "targets": {"review": ["methods.m-search-strategy"]},
     "evidence": [{"kind": "record", "path": "review/searches.jsonl"}],
     "question": "Are the full search strings given, filters and limits included?"},
    {"number": 8, "section": "Methods", "topic": "Selection process",
     "targets": {"review": ["methods.m-selection-process"]},
     "evidence": [{"kind": "record", "path": "review/screening.jsonl", "field": "stage", "values": ["ta", "ft"]}],
     "question": "Does the text say how many reviewers screened, independently or not, and with which tools?"},
    {"number": 9, "section": "Methods", "topic": "Data collection process",
     "targets": {"review": ["methods.m-data-collection"]},
     "evidence": [{"kind": "record", "path": "review/extraction.jsonl"}],
     "question": "Is it clear how data were collected from reports and how they were confirmed?"},
    {"number": 10, "section": "Methods", "topic": "Data items",
     "targets": {"review": ["methods.m-data-collection"]},
     "evidence": [{"kind": "command", "script": "skills/systematic-review/scripts/review_cli.py", "argv": ["--root", "{root}", "protocol", "check"], "expect": {"ok": true}}],
     "question": "Are the outcomes and other variables sought listed, with assumptions about missing information?"},
    {"number": 11, "section": "Methods", "topic": "Study risk of bias assessment",
     "targets": {"review": ["methods.m-risk-of-bias"]},
     "evidence": [{"kind": "record", "path": "review/appraisal.jsonl"}],
     "question": "Are the appraisal tool, the number of assessors and their independence stated?"},
    {"number": 12, "section": "Methods", "topic": "Effect measures",
     "targets": {"review": ["methods.m-synthesis"]},
     "question": "Is the effect measure for each outcome stated, or its absence justified for a narrative synthesis?"},
    {"number": 13, "section": "Methods", "topic": "Synthesis methods",
     "targets": {"review": ["methods.m-synthesis"]},
     "question": "Are eligibility for each synthesis, data preparation, synthesis and heterogeneity methods described?"},
    {"number": 14, "section": "Methods", "topic": "Reporting bias assessment",
     "targets": {"review": ["methods.m-certainty"]},
     "question": "Is the method for assessing bias from missing results described?"},
    {"number": 15, "section": "Methods", "topic": "Certainty assessment",
     "targets": {"review": ["methods.m-certainty"]},
     "question": "Is the method for rating certainty or confidence in the body of evidence described?"},
    {"number": 16, "section": "Results", "topic": "Study selection",
     "targets": {"review": ["results.r-study-selection"]},
     "evidence": [{"kind": "file", "path": "review/prisma.json"},
                  {"kind": "file", "path": "paper/Figures/prisma-flow.svg"},
                  {"kind": "number", "path": "review/prisma.json", "pointer": "identification.records"},
                  {"kind": "number", "path": "review/prisma.json", "pointer": "included.studies"}],
     "question": "Are excluded studies that seemed eligible cited with why they were excluded?"},
    {"number": 17, "section": "Results", "topic": "Study characteristics",
     "targets": {"review": ["results.r-study-characteristics"]},
     "evidence": [{"kind": "record", "path": "review/extraction.jsonl"}],
     "question": "Is each included study cited with its characteristics?"},
    {"number": 18, "section": "Results", "topic": "Risk of bias in studies",
     "targets": {"review": ["results.r-risk-of-bias"]},
     "evidence": [{"kind": "record", "path": "review/appraisal.jsonl"}],
     "question": "Is the risk-of-bias assessment reported for each included study?"},
    {"number": 19, "section": "Results", "topic": "Results of individual studies",
     "targets": {"review": ["results.r-thematic-synthesis"]},
     "evidence": [{"kind": "record", "path": "review/extraction.jsonl"}],
     "question": "Are per-study summary statistics and effect estimates with precision presented?"},
    {"number": 20, "section": "Results", "topic": "Results of syntheses",
     "targets": {"review": ["results.r-thematic-synthesis"]},
     "question": "Does each synthesis report its contributing studies, results and heterogeneity?"},
    {"number": 21, "section": "Results", "topic": "Reporting biases",
     "targets": {"review": ["results.r-thematic-synthesis"]},
     "question": "Is the assessment of bias from missing results reported for each synthesis?"},
    {"number": 22, "section": "Results", "topic": "Certainty of evidence",
     "targets": {"review": ["results.r-thematic-synthesis"]},
     "question": "Is the certainty or confidence in the evidence reported for each outcome?"},
    {"number": 23, "section": "Discussion", "topic": "Discussion",
     "targets": {"review": ["discussion", "limitations"]},
     "question": "Does the discussion interpret the results, name the evidence's and the process's limitations and their implications?"},
    {"number": 24, "section": "Other information", "topic": "Registration and protocol",
     "targets": {"review": ["methods.m-protocol-registration"]},
     "evidence": [{"kind": "file", "path": "review/protocol.lock.json"},
                  {"kind": "declaration", "name": "review-registration"}],
     "question": "Are the registration, where the protocol can be read and any amendment stated?"},
    {"number": 25, "section": "Other information", "topic": "Support",
     "targets": {"review": ["back-matter.bm-funding"]},
     "question": "Are the sources of support and the role of funders or sponsors stated?"},
    {"number": 26, "section": "Other information", "topic": "Competing interests",
     "targets": {"review": ["back-matter.bm-conflicts-of-interest"]},
     "question": "Are the authors' competing interests declared?"},
    {"number": 27, "section": "Other information", "topic": "Availability of data, code and other materials",
     "targets": {"review": ["back-matter.bm-data-availability"]},
     "question": "Does the text say which data, code and other materials are public and where?"}
  ]
}
